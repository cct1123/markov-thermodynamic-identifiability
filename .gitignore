# Operating-system and editor residue
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.swp
*.swo
*~

# Local credentials and environment overrides
.env
.env.*
!.env.example

# Human prompt history stays local; PROJECT.md is the research brief.
/prompt log.txt

# Disposable runtime environments and caches, if used later
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Local manuscript compiler, page renders, and extracted replay workspaces
/tmp/
/manuscript/*.aux
/manuscript/*.blg
/manuscript/*.log
/manuscript/*.out
/manuscript/*Notes.bib

# Keep scientific inputs, analysis artifacts, outputs, and dependency lockfiles
# visible to Git; add narrow exclusions only when a real workflow needs them.
